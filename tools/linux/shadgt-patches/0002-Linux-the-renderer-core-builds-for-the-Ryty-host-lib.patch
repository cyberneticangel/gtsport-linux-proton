From 3634bf10dcdcdbc26a73bc227e57080595eda7e9 Mon Sep 17 00:00:00 2001
From: cyberneticangel <dylan.fantauzzo7@proton.me>
Date: Mon, 19 Oct 2026 19:11:49 +0200
Subject: [PATCH 02/12] Linux: the renderer core builds for the Ryty host
 libraries

- CMake: allow non-Windows builds with SHADGT_RYTY_GPU=ON.
- <intrin.h> only with MSVC; <x86intrin.h> elsewhere.
- vk_platform.cpp: undefine Xlib's None/Always/Bool/Status/Success, which
  collide with renderer enumerators.
- page_manager.cpp, buffer_cache.cpp: ryty_diag.h (and spin_lock.h,
  guest_hash.h) on every platform; the Linux branches used RYDIAG_SCOPE too.
- image.cpp, buffer_cache.cpp: explicit u64/VAddr types where strtoull and
  size literals are unsigned long long.
- proto_import.cpp: the Windows memory-kind probes are Windows-only.
---
 CMakeLists.txt                                 | 4 ++--
 ryty_gpu/ryty_core_shims.cpp                   | 4 ++++
 ryty_gpu/ryty_diag.h                           | 4 ++++
 src/common/perf_monitor.cpp                    | 4 ++++
 src/common/perf_monitor.h                      | 4 ++++
 src/common/rdtsc.h                             | 4 ++++
 src/common/spin_lock.cpp                       | 4 ++++
 src/common/uint128.h                           | 4 ++++
 src/video_core/buffer_cache/buffer_cache.cpp   | 8 ++++++--
 src/video_core/buffer_cache/proto_import.cpp   | 2 ++
 src/video_core/page_manager.cpp                | 3 +--
 src/video_core/renderer_vulkan/vk_platform.cpp | 9 +++++++++
 src/video_core/texture_cache/image.cpp         | 2 +-
 13 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff6430a4..d8192e1e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -13,8 +13,8 @@ endif()
 
 project(shadPS4 CXX C ASM)
 
-if(NOT WIN32)
-    message(FATAL_ERROR "shadGT supports Windows builds only.")
+if(NOT WIN32 AND NOT SHADGT_RYTY_GPU)
+    message(FATAL_ERROR "shadGT supports Windows builds only (on Linux, only the Ryty host libraries: -DSHADGT_RYTY_GPU=ON).")
 endif()
 
