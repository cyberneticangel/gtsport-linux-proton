+// PERF-154: guest memory registered with a userfaultfd in asynchronous write-protect mode. A CPU
+// write to a protected page does not fault: the kernel lifts the protection, and PAGEMAP_SCAN
+// later lists the pages without it and protects them again in the same call. Pages of memory
+// that cannot be registered keep mprotect tracking.
+struct WriteScan {
+    int uffd = -1;
+    int pagemap = -1;
+    std::mutex registry_mutex;
+    std::vector<std::pair<VAddr, VAddr>> registered; // sorted, disjoint
+    std::vector<std::pair<VAddr, VAddr>> refused;
+    std::atomic<VAddr> low{~VAddr{0}};
+    std::atomic<VAddr> high{0};
+    std::mutex scan_mutex;
+    std::vector<page_region> regions = std::vector<page_region>(4096);
+    // Statistics, reported every 2 s.
+    u64 scans{};
+    u64 scan_ns{};
+    u64 written_pages{};
+    u64 reported_pages{};
+    u64 registrations{};
+    std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+
+    static WriteScan* Get() {
+        static WriteScan* scan = [] () -> WriteScan* {
+            const char* env = std::getenv("SHADGT_WRITE_SCAN");
+            if (!env || env[0] != '1') {
+                return nullptr;
+            }
+            auto* s = new WriteScan;
+            s->uffd = static_cast<int>(
+                syscall(SYS_userfaultfd, O_CLOEXEC | O_NONBLOCK | UFFD_USER_MODE_ONLY));
+            uffdio_api api{};
+            api.api = UFFD_API;
+            api.features = UFFD_FEATURE_WP_ASYNC | UFFD_FEATURE_WP_HUGETLBFS_SHMEM |
+                           UFFD_FEATURE_WP_UNPOPULATED;
+            s->pagemap = open("/proc/self/pagemap", O_RDONLY | O_CLOEXEC);
+            // (Possibly before logging is set up: the page manager reports the outcome.)
+            if (s->uffd < 0 || ioctl(s->uffd, UFFDIO_API, &api) != 0 || s->pagemap < 0) {
+                Failure() = Common::GetLastErrorMsg();
+                return nullptr;
+            }
+            return s;
+        }();
+        return scan;
+    }
+
+    static std::string& Failure() {
+        static std::string failure;
+        return failure;
+    }
+
+    static bool Contains(const std::vector<std::pair<VAddr, VAddr>>& set, VAddr address) {
+        auto it = std::upper_bound(set.begin(), set.end(), address,
+                                   [](VAddr a, const auto& r) { return a < r.first; });
+        return it != set.begin() && address < std::prev(it)->second;
+    }
+
+    static void Insert(std::vector<std::pair<VAddr, VAddr>>& set, VAddr start, VAddr end) {
+        auto it = std::lower_bound(set.begin(), set.end(), start,
+                                   [](const auto& r, VAddr a) { return r.second < a; });
+        while (it != set.end() && it->first <= end) {
+            start = std::min(start, it->first);
+            end = std::max(end, it->second);
+            it = set.erase(it);
+        }
+        set.insert(it, {start, end});
+    }
+
+    static void Remove(std::vector<std::pair<VAddr, VAddr>>& set, VAddr start, VAddr end) {
+        std::vector<std::pair<VAddr, VAddr>> out;
+        out.reserve(set.size() + 1);
+        for (const auto& [a, b] : set) {
+            if (b <= start || a >= end) {
+                out.emplace_back(a, b);
+                continue;
+            }
+            if (a < start) {
+                out.emplace_back(a, start);
+            }
+            if (b > end) {
+                out.emplace_back(end, b);
+            }
+        }
+        set = std::move(out);
+    }
+
+    /// Registers [start, end) and write-protects it; false if the kernel refuses (memory of a
+    /// kind it cannot track, or a hole).
+    bool Register(VAddr start, VAddr end) {
+        uffdio_register reg{};
+        reg.range.start = start;
+        reg.range.len = end - start;
+        reg.mode = UFFDIO_REGISTER_MODE_WP;
+        if (ioctl(uffd, UFFDIO_REGISTER, &reg) != 0) {
+            return false;
+        }
+        uffdio_writeprotect wp{};
+        wp.range.start = start;
+        wp.range.len = end - start;
+        wp.mode = UFFDIO_WRITEPROTECT_MODE_WP;
+        if (ioctl(uffd, UFFDIO_WRITEPROTECT, &wp) != 0) {
+            return false;
+        }
+        ++registrations;
+        return true;
+    }
+
+    /// The mapping was (re)created: register it.
+    void OnMap(VAddr start, VAddr end) {
+        std::scoped_lock lk{registry_mutex};
+        Remove(refused, start, end);
+        if (Register(start, end)) {
+            Insert(registered, start, end);
+            low.store(std::min(low.load(), start));
+            high.store(std::max(high.load(), end));
+        } else {
+            Remove(registered, start, end);
+            Insert(refused, start, end);
+        }
+    }
+
+    void OnUnmap(VAddr start, VAddr end) {
+        std::scoped_lock lk{registry_mutex};
+        Remove(registered, start, end);
+        Remove(refused, start, end);
+    }
+
+    /// Whether writes to the page are found by the scan. Memory mapped before the renderer
+    /// existed was never reported to it: its mapping is registered on first use.
+    bool Covers(VAddr page) {
+        std::scoped_lock lk{registry_mutex};
+        if (Contains(registered, page)) {
+            return true;
+        }
+        if (Contains(refused, page)) {
+            return false;
+        }
+#ifdef RYTY_GPU
+        MEMORY_BASIC_INFORMATION info{};
+        if (VirtualQuery(reinterpret_cast<void*>(page), &info, sizeof(info)) == sizeof(info) &&
+            info.State == MEM_COMMIT) {
+            const VAddr start = reinterpret_cast<VAddr>(info.BaseAddress);
+            const VAddr end = start + info.RegionSize;
+            if (Register(start, end)) {
+                Insert(registered, start, end);
+                low.store(std::min(low.load(), start));
+                high.store(std::max(high.load(), end));
+                return true;
+            }
+            Insert(refused, start, end);
+            return false;
+        }
+#endif
+        Insert(refused, page, page + 4096);
+        return false;
+    }
+};
+
