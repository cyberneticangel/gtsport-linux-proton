+    /// PERF-154: one PAGEMAP_SCAN over the registered memory; written pages with a write watcher
+    /// go to the caches as their write faults would have.
+    void ScanWrites() {
+#ifdef __linux__
+        auto* scan = WriteScan::Get();
+        if (!scan || !rasterizer) {
+            return;
+        }
+        std::scoped_lock lk{scan->scan_mutex};
+        const VAddr low = scan->low.load();
+        const VAddr high = scan->high.load();
+        if (low >= high) {
+            return;
+        }
+        const auto start_time = std::chrono::steady_clock::now();
+        pm_scan_arg arg{};
+        arg.size = sizeof(arg);
+        arg.flags = PM_SCAN_WP_MATCHING;
+        arg.start = low;
+        arg.end = high;
+        arg.vec = reinterpret_cast<u64>(scan->regions.data());
+        arg.vec_len = scan->regions.size();
+        // Registered memory only: elsewhere every page would count as written.
+        arg.category_mask = PAGE_IS_WRITTEN | PAGE_IS_WPALLOWED;
+        arg.return_mask = PAGE_IS_WRITTEN;
+        while (true) {
+            const long count = ioctl(scan->pagemap, PAGEMAP_SCAN, &arg);
+            if (count < 0) {
+                static std::atomic<u32> logged{};
+                if (logged++ < 10) {
+                    LOG_ERROR(Render, "PERF-154: PAGEMAP_SCAN of {:#x}-{:#x} failed: {}",
+                              arg.start, arg.end, Common::GetLastErrorMsg());
+                }
+                break;
+            }
+            for (long i = 0; i < count; ++i) {
+                ReportWrites(*scan, scan->regions[i].start, scan->regions[i].end);
+            }
+            if (arg.walk_end >= high || count < static_cast<long>(arg.vec_len)) {
+                break;
+            }
+            arg.start = arg.walk_end;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        ++scan->scans;
+        scan->scan_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(now - start_time).count();
+        if (now - scan->window >= std::chrono::seconds{2}) {
+            LOG_WARNING(Render,
+                        "PERF-154: write scans in 2 s: {} taking {:.1f} ms, {} written pages, {} "
+                        "with watchers reported, {} registrations, {} written pages held GPU "
+                        "data",
+                        scan->scans, scan->scan_ns / 1e6, scan->written_pages,
+                        scan->reported_pages, scan->registrations,
+                        rasterizer->GetBufferCache().TakeScannedGpuWrites());
+            scan->scans = scan->scan_ns = scan->written_pages = scan->reported_pages = 0;
+            scan->registrations = 0;
+            scan->window = now;
+        }
+#endif
+    }
+
+#ifdef __linux__
+    void ReportWrites(WriteScan& scan, VAddr start, VAddr end) {
+        VAddr run = 0;
+        const auto flush = [&](VAddr at) {
