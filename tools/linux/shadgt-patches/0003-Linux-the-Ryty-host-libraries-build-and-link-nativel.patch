diff --git a/ryty_gpu/ryty_win32_compat.cpp b/ryty_gpu/ryty_win32_compat.cpp
new file mode 100644
index 00000000..49de2268
--- /dev/null
+++ b/ryty_gpu/ryty_win32_compat.cpp
@@ -0,0 +1,222 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Linux side of ryty_win32_compat.h.
+
+#ifndef _WIN32
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <mutex>
+#include <vector>
+#include <fcntl.h>
+#include <link.h>
+#include <sys/uio.h>
+
+#include "ryty_gpu/ryty_win32_compat.h"
+
+namespace RytyCompat {
+namespace {
+
+struct Mapping {
+    std::uintptr_t start;
+    std::uintptr_t end;
+    int prot;
+    bool shared;
+};
+
+// A sorted snapshot of /proc/self/maps. Reading the file costs about as much as the process has
+// mappings (GT Sport has tens of thousands), so lookups search the snapshot and it is read again
+// only after a change made here, when a lookup misses, or when it is older than MaxAgeNs (the
+// runtime maps and unmaps guest memory without telling the renderer).
+struct Snapshot {
+    std::mutex mutex;
+    std::vector<Mapping> mappings;
+    std::uint64_t read_at_ns = 0;
+    std::atomic<bool> stale{true};
+};
+
+constexpr std::uint64_t MaxAgeNs = 100'000'000;
+
+Snapshot& GetSnapshot() {
+    static Snapshot snapshot;
+    return snapshot;
+}
+
+std::uint64_t NowNs() {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<std::uint64_t>(now.tv_sec) * 1'000'000'000 + now.tv_nsec;
+}
+
+void ReadMappings(std::vector<Mapping>& out) {
+    out.clear();
+    FILE* file = std::fopen("/proc/self/maps", "re");
+    if (file == nullptr) {
+        return;
+    }
+    char line[512];
+    while (std::fgets(line, sizeof(line), file)) {
+        unsigned long start = 0, end = 0;
+        char perms[5] = {};
+        if (std::sscanf(line, "%lx-%lx %4s", &start, &end, perms) != 3) {
+            continue;
+        }
+        int prot = PROT_NONE;
+        prot |= perms[0] == 'r' ? PROT_READ : 0;
+        prot |= perms[1] == 'w' ? PROT_WRITE : 0;
+        prot |= perms[2] == 'x' ? PROT_EXEC : 0;
+        out.push_back({start, end, prot, perms[3] == 's'});
+    }
+    std::fclose(file);
+}
+
+const Mapping* Find(const std::vector<Mapping>& mappings, std::uintptr_t address) {
+    auto it = std::upper_bound(mappings.begin(), mappings.end(), address,
+                               [](std::uintptr_t a, const Mapping& m) { return a < m.start; });
+    if (it == mappings.begin()) {
+        return nullptr;
+    }
+    --it;
+    return address < it->end ? &*it : nullptr;
+}
+
+} // namespace
+
+int ProtFromPage(DWORD page) {
+    switch (page & 0xFF) {
+    case PAGE_READONLY:
+        return PROT_READ;
+    case PAGE_READWRITE:
+    case PAGE_WRITECOPY:
+        return PROT_READ | PROT_WRITE;
+    case PAGE_EXECUTE:
+        return PROT_EXEC;
+    case PAGE_EXECUTE_READ:
+        return PROT_READ | PROT_EXEC;
+    case PAGE_EXECUTE_READWRITE:
+    case PAGE_EXECUTE_WRITECOPY:
+        return PROT_READ | PROT_WRITE | PROT_EXEC;
+    default:
+        return PROT_NONE;
+    }
+}
+
+DWORD PageFromProt(int prot) {
+    const bool r = prot & PROT_READ, w = prot & PROT_WRITE, x = prot & PROT_EXEC;
+    if (x) {
+        return w ? PAGE_EXECUTE_READWRITE : (r ? PAGE_EXECUTE_READ : PAGE_EXECUTE);
+    }
+    return w ? PAGE_READWRITE : (r ? PAGE_READONLY : PAGE_NOACCESS);
+}
+
+void MappingsChanged() {
+    GetSnapshot().stale.store(true, std::memory_order_release);
+}
+
+bool QueryMapping(std::uintptr_t address, MEMORY_BASIC_INFORMATION& info) {
+    constexpr std::uintptr_t UserEnd = 0x0000800000000000ULL;
+    if (address >= UserEnd) {
+        return false;
+    }
+    auto& snapshot = GetSnapshot();
+    std::scoped_lock lk{snapshot.mutex};
+    const std::uint64_t now = NowNs();
+    bool fresh = false;
+    if (snapshot.stale.exchange(false, std::memory_order_acq_rel) ||
+        now - snapshot.read_at_ns > MaxAgeNs) {
+        ReadMappings(snapshot.mappings);
+        snapshot.read_at_ns = now;
+        fresh = true;
+    }
+    const Mapping* mapping = Find(snapshot.mappings, address);
+    if (mapping == nullptr && !fresh) {
+        ReadMappings(snapshot.mappings); // mapped since the snapshot was taken?
+        snapshot.read_at_ns = now;
+        mapping = Find(snapshot.mappings, address);
+    }
+    info = {};
+    if (mapping != nullptr) {
+        info.BaseAddress = reinterpret_cast<void*>(mapping->start);
+        info.AllocationBase = info.BaseAddress;
+        info.RegionSize = mapping->end - mapping->start;
+        info.State = MEM_COMMIT;
+        info.Protect = PageFromProt(mapping->prot);
+        info.AllocationProtect = info.Protect;
+        return true;
+    }
+    // A gap: from the address to the next mapping (or the end of the user address space).
+    auto next = std::upper_bound(snapshot.mappings.begin(), snapshot.mappings.end(), address,
+                                 [](std::uintptr_t a, const Mapping& m) { return a < m.start; });
+    const std::uintptr_t page = static_cast<std::uintptr_t>(sysconf(_SC_PAGESIZE));
+    const std::uintptr_t base = address & ~(page - 1);
+    const std::uintptr_t end = next != snapshot.mappings.end() ? next->start : UserEnd;
+    info.BaseAddress = reinterpret_cast<void*>(base);
+    info.RegionSize = end - base;
+    info.State = MEM_FREE;
+    info.Protect = PAGE_NOACCESS;
+    return true;
+}
+
+void MainImageRange(std::uintptr_t& start, std::uintptr_t& end) {
+    struct Range {
+        std::uintptr_t start = ~std::uintptr_t{0};
+        std::uintptr_t end = 0;
+    } range;
+    dl_iterate_phdr(
+        [](dl_phdr_info* info, size_t, void* data) -> int {
+            // The first object is the main executable.
+            auto* r = static_cast<Range*>(data);
+            for (int i = 0; i < info->dlpi_phnum; ++i) {
+                const auto& ph = info->dlpi_phdr[i];
+                if (ph.p_type != PT_LOAD) {
+                    continue;
+                }
+                r->start = std::min<std::uintptr_t>(r->start, info->dlpi_addr + ph.p_vaddr);
+                r->end = std::max<std::uintptr_t>(r->end, info->dlpi_addr + ph.p_vaddr + ph.p_memsz);
+            }
+            return 1;
+        },
+        &range);
+    start = range.start;
+    end = range.end;
+}
+
+std::uintptr_t MainImageBias() {
+    static const std::uintptr_t bias = [] {
+        std::uintptr_t result = 0;
+        dl_iterate_phdr(
+            [](dl_phdr_info* info, size_t, void* data) -> int {
+                *static_cast<std::uintptr_t*>(data) = info->dlpi_addr; // the main executable
+                return 1;
+            },
+            &result);
+        return result;
+    }();
+    return bias;
+}
+
+bool SafeCopy(void* dest, const void* source, std::size_t size) {
+    // process_vm_readv on this process checks both ranges and fails with EFAULT instead of
+    // faulting, as __try/__except around a memcpy does on Windows.
+    iovec local{dest, size};
+    iovec remote{const_cast<void*>(source), size};
+    return process_vm_readv(getpid(), &local, 1, &remote, 1, 0) == static_cast<ssize_t>(size);
+}
+
+bool WriteIgnoringProtection(void* dest, const void* source, std::size_t size) {
+    // Writes through /proc/self/mem go to the pages whatever their protection (the kernel forces
+    // them), so write tracking's protections stay as they are and no fault is raised.
+    static const int memory = open("/proc/self/mem", O_RDWR | O_CLOEXEC);
+    if (memory < 0) {
+        return false;
+    }
+    return pwrite(memory, source, size, static_cast<off_t>(reinterpret_cast<std::uintptr_t>(dest))) ==
+           static_cast<ssize_t>(size);
+}
+
+} // namespace RytyCompat
+
+#endif // !_WIN32
