+
+using DWORD = std::uint32_t;
+using WORD = std::uint16_t;
+using LONG = std::int32_t;
+using BOOL = int;
+using BYTE = std::uint8_t;
+using ULONG_PTR = std::uintptr_t;
+using SIZE_T = std::size_t;
+using HANDLE = void*;
+using HMODULE = void*;
+using FARPROC = void*;
+using LPVOID = void*;
+using LPCVOID = const void*;
+
+// __declspec(dllexport) marks the libraries' exports; on Linux, symbols with default visibility.
+#define __declspec(x) __attribute__((visibility("default")))
+
+#ifndef TRUE
+#define TRUE 1
+#define FALSE 0
+#endif
+
+inline constexpr DWORD MAX_PATH = 4096;
+
+inline constexpr DWORD PAGE_NOACCESS = 0x01;
+inline constexpr DWORD PAGE_READONLY = 0x02;
+inline constexpr DWORD PAGE_READWRITE = 0x04;
+inline constexpr DWORD PAGE_WRITECOPY = 0x08;
+inline constexpr DWORD PAGE_EXECUTE = 0x10;
+inline constexpr DWORD PAGE_EXECUTE_READ = 0x20;
+inline constexpr DWORD PAGE_EXECUTE_READWRITE = 0x40;
+inline constexpr DWORD PAGE_EXECUTE_WRITECOPY = 0x80;
+inline constexpr DWORD PAGE_GUARD = 0x100;
+
+inline constexpr DWORD MEM_COMMIT = 0x1000;
+inline constexpr DWORD MEM_RESERVE = 0x2000;
+inline constexpr DWORD MEM_FREE = 0x10000;
+inline constexpr DWORD MEM_RELEASE = 0x8000;
+
+/// One mapping of the process, as VirtualQuery describes a region: a Linux mapping has a single
+/// protection, so the region and the allocation are the mapping.
+struct MEMORY_BASIC_INFORMATION {
+    void* BaseAddress;
+    void* AllocationBase;
+    DWORD AllocationProtect;
+    SIZE_T RegionSize;
+    DWORD State;
+    DWORD Protect;
+    DWORD Type;
+};
+
+namespace RytyCompat {
+/// The mapping containing address (State MEM_COMMIT), or the gap up to the next mapping
+/// (State MEM_FREE). Returns false only above the user address space.
+bool QueryMapping(std::uintptr_t address, MEMORY_BASIC_INFORMATION& info);
+/// Forgets the cached mappings (after the process maps or unmaps memory).
+void MappingsChanged();
+/// The PROT_* bits for a PAGE_* value, and back.
+int ProtFromPage(DWORD page);
+DWORD PageFromProt(int prot);
+/// The range [start, end) of the main executable's loaded image.
+void MainImageRange(std::uintptr_t& start, std::uintptr_t& end);
+/// Where the main executable is loaded: the address of its virtual address 0.
+std::uintptr_t MainImageBias();
+/// Ryty's Windows converter places the game's code and data 0x10000 above the executable's base
+/// (the renderer's kTextRvaShift); the Linux converter keeps them at their own virtual addresses.
+inline constexpr std::uintptr_t WindowsTextShift = 0x10000;
+/// Copies size bytes, false (and no fault) when part of either range is not accessible.
+bool SafeCopy(void* dest, const void* source, std::size_t size);
+/// Writes size bytes into this process's memory regardless of page protections.
+bool WriteIgnoringProtection(void* dest, const void* source, std::size_t size);
+} // namespace RytyCompat
+
+inline SIZE_T VirtualQuery(LPCVOID address, MEMORY_BASIC_INFORMATION* info, SIZE_T size) {
+    if (size < sizeof(MEMORY_BASIC_INFORMATION) ||
+        !RytyCompat::QueryMapping(reinterpret_cast<std::uintptr_t>(address), *info)) {
+        return 0;
+    }
+    return sizeof(MEMORY_BASIC_INFORMATION);
+}
+
+inline BOOL VirtualProtect(LPVOID address, SIZE_T size, DWORD protect, DWORD* old_protect) {
+    const std::uintptr_t page = static_cast<std::uintptr_t>(sysconf(_SC_PAGESIZE));
+    const std::uintptr_t start = reinterpret_cast<std::uintptr_t>(address) & ~(page - 1);
+    const std::uintptr_t end =
+        (reinterpret_cast<std::uintptr_t>(address) + (size ? size : 1) + page - 1) & ~(page - 1);
+    if (old_protect != nullptr) {
+        MEMORY_BASIC_INFORMATION info{};
+        *old_protect = RytyCompat::QueryMapping(start, info) && info.State == MEM_COMMIT
+                           ? info.Protect
+                           : PAGE_NOACCESS;
+    }
+    if (mprotect(reinterpret_cast<void*>(start), end - start, RytyCompat::ProtFromPage(protect)) !=
+        0) {
+        return FALSE;
+    }
+    RytyCompat::MappingsChanged();
+    return TRUE;
+}
+
+inline LPVOID VirtualAlloc(LPVOID address, SIZE_T size, DWORD type, DWORD protect) {
+    const int prot = (type & MEM_COMMIT) != 0 ? RytyCompat::ProtFromPage(protect) : PROT_NONE;
+    void* result = mmap(address, size, prot,
+                        MAP_PRIVATE | MAP_ANONYMOUS | (address ? MAP_FIXED_NOREPLACE : 0), -1, 0);
+    if (result == MAP_FAILED) {
+        return nullptr;
+    }
+    RytyCompat::MappingsChanged();
+    return result;
+}
+
+inline BOOL VirtualFree(LPVOID address, SIZE_T size, DWORD /*type*/) {
+    // MEM_RELEASE with size 0 frees the whole allocation: the mapping holding the address.
+    if (size == 0) {
+        MEMORY_BASIC_INFORMATION info{};
+        if (!RytyCompat::QueryMapping(reinterpret_cast<std::uintptr_t>(address), info)) {
+            return FALSE;
+        }
+        size = info.RegionSize;
+    }
+    const BOOL ok = munmap(address, size) == 0;
+    RytyCompat::MappingsChanged();
+    return ok;
+}
+
+inline BOOL FlushInstructionCache(HANDLE, LPCVOID address, SIZE_T size) {
+    auto* start = static_cast<char*>(const_cast<void*>(address));
+    __builtin___clear_cache(start, start + size);
+    return TRUE;
+}
+
+inline HANDLE GetCurrentProcess() {
+    return reinterpret_cast<HANDLE>(-1);
+}
+
+inline DWORD GetCurrentThreadId() {
+    return static_cast<DWORD>(syscall(SYS_gettid));
+}
+
+inline DWORD GetLastError() {
+    return static_cast<DWORD>(errno);
+}
+
+inline std::uint64_t GetTickCount64() {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<std::uint64_t>(now.tv_sec) * 1000 + static_cast<std::uint64_t>(now.tv_nsec) / 1000000;
+}
+
+/// A module of the process by file name ("libc.prx"). For nullptr, as on Windows, the main
+/// executable's base address: code computes game addresses as base + 0x10000 + eboot address
+/// (the Windows layout), so on Linux it is the load address minus that shift. Not a handle for
+/// GetProcAddress.
+inline HMODULE GetModuleHandleA(const char* name) {
+    if (name == nullptr) {
+        return reinterpret_cast<HMODULE>(RytyCompat::MainImageBias() - RytyCompat::WindowsTextShift);
+    }
+    return dlopen(name, RTLD_LAZY | RTLD_NOLOAD);
+}
+
+inline FARPROC GetProcAddress(HMODULE module, const char* name) {
+    return module ? dlsym(module, name) : nullptr;
+}
+
+inline BOOL FreeLibrary(HMODULE module) {
+    return module && dlclose(module) == 0;
+}
+
+inline BOOL CloseHandle(HANDLE) {
+    return TRUE;
+}
+
+inline std::uint16_t _byteswap_ushort(std::uint16_t value) {
+    return __builtin_bswap16(value);
+}
+inline std::uint32_t _byteswap_ulong(std::uint32_t value) {
+    return __builtin_bswap32(value);
+}
+inline std::uint64_t _byteswap_uint64(std::uint64_t value) {
+    return __builtin_bswap64(value);
+}
+
+inline DWORD GetTickCount() {
+    return static_cast<DWORD>(GetTickCount64());
+}
+
+inline void Sleep(DWORD milliseconds) {
+    usleep(static_cast<useconds_t>(milliseconds) * 1000);
+}
+
+/// The file a module was loaded from (the main executable for nullptr), as Windows fills it:
+/// truncated to size - 1 characters, returns the length.
+inline DWORD GetModuleFileNameA(HMODULE module, char* buffer, DWORD size) {
+    if (size == 0) {
+        return 0;
+    }
+    std::string path;
+    if (module == nullptr) {
+        char exe[MAX_PATH];
+        const ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+        path.assign(exe, n > 0 ? static_cast<std::size_t>(n) : 0);
+    } else {
+        Dl_info info{};
+        // A handle from dlopen is not an address: ask for the file of a symbol in the module.
+        void* symbol = dlsym(module, "RytyLibraryInitialize");
+        if (symbol != nullptr && dladdr(symbol, &info) && info.dli_fname != nullptr) {
+            path = info.dli_fname;
+        }
+    }
+    const std::size_t length = std::min<std::size_t>(path.size(), size - 1);
+    std::memcpy(buffer, path.data(), length);
+    buffer[length] = '\0';
+    return static_cast<DWORD>(length);
+}
+
+inline DWORD GetModuleFileNameW(HMODULE module, wchar_t* buffer, DWORD size) {
+    std::vector<char> narrow(size ? size : 1);
+    const DWORD length = GetModuleFileNameA(module, narrow.data(), size);
+    for (DWORD i = 0; i <= length && i < size; ++i) {
+        buffer[i] = static_cast<unsigned char>(narrow[i]); // file names here are ASCII
+    }
+    return length;
+}
+
+inline HMODULE GetModuleHandleW(const wchar_t* name) {
+    if (name == nullptr) {
+        return GetModuleHandleA(nullptr);
+    }
+    std::string narrow;
+    for (const wchar_t* c = name; *c; ++c) {
+        narrow += static_cast<char>(*c);
+    }
+    return GetModuleHandleA(narrow.c_str());
+}
+
+/// Slim reader/writer locks, as pthread read-write locks.
+struct SRWLOCK {
+    pthread_rwlock_t lock = PTHREAD_RWLOCK_INITIALIZER;
+};
+#define SRWLOCK_INIT {}
+inline void InitializeSRWLock(SRWLOCK* lock) {
+    pthread_rwlock_init(&lock->lock, nullptr);
+}
+inline void AcquireSRWLockShared(SRWLOCK* lock) {
+    pthread_rwlock_rdlock(&lock->lock);
+}
+inline void ReleaseSRWLockShared(SRWLOCK* lock) {
+    pthread_rwlock_unlock(&lock->lock);
+}
+inline void AcquireSRWLockExclusive(SRWLOCK* lock) {
+    pthread_rwlock_wrlock(&lock->lock);
+}
+inline void ReleaseSRWLockExclusive(SRWLOCK* lock) {
+    pthread_rwlock_unlock(&lock->lock);
+}
