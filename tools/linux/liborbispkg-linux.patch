diff --git a/LibOrbisPkg/PFS/PFSCReader.cs b/LibOrbisPkg/PFS/PFSCReader.cs
index 12c6c1b..cb1283e 100644
--- a/LibOrbisPkg/PFS/PFSCReader.cs
+++ b/LibOrbisPkg/PFS/PFSCReader.cs
@@ -84,7 +84,12 @@ namespace LibOrbisPkg.PFS
         using (var bufStream = new MemoryStream(sectorBuf))
         using (var ds = new DeflateStream(bufStream, CompressionMode.Decompress))
         {
-          ds.Read(output, 0, hdr.BlockSz);
+          // Stream.Read may return less than asked for (DeflateStream does since .NET 6): read the whole block.
+          int done = 0, n;
+          while (done < hdr.BlockSz && (n = ds.Read(output, done, hdr.BlockSz - done)) > 0)
+            done += n;
+          if (done < hdr.BlockSz)
+            throw new InvalidDataException($"PFSC block {idx} inflated to {done} of {hdr.BlockSz} bytes");
         }
       }
     }
