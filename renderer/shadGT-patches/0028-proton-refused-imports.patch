From 17c309bc85517332811c26ed3424a033414918e6 Mon Sep 17 00:00:00 2001
From: cyberneticangel <dylan.fantauzzo7@proton.me>
Date: Mon, 19 Oct 2026 14:54:37 +0200
Subject: [PATCH] ryGT: stop importing guest memory the driver always refuses
 (Proton on AMD)

---
 src/video_core/buffer_cache/direct_memory.cpp | 13 ++++++++++++-
 src/video_core/buffer_cache/direct_memory.h   |  2 ++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/video_core/buffer_cache/direct_memory.cpp b/src/video_core/buffer_cache/direct_memory.cpp
index 38bbe75d..4d7401e2 100644
--- a/src/video_core/buffer_cache/direct_memory.cpp
+++ b/src/video_core/buffer_cache/direct_memory.cpp
@@ -220,7 +220,7 @@ bool DirectMemory::ImportView(VAddr address) {
     if (base == 0) {
         return false;
     }
-    if (std::ranges::binary_search(failed, base)) {
+    if (imports_refused || std::ranges::binary_search(failed, base)) {
         return false;
     }
     const VAddr end = GuestViewEnd(base, 1ULL << 32);
@@ -265,6 +265,17 @@ bool DirectMemory::ImportView(VAddr address) {
     VkDeviceMemory memory{};
     if (const VkResult r = d.vkAllocateMemory(device, &info, nullptr, &memory); r != VK_SUCCESS) {
         UnmapAlias()(alias);
+        // Proton on AMD: Wine backs sections with shared file mappings and amdgpu imports only
+        // anonymous memory, so every guest view is refused. Each try maps an alias and asks the
+        // kernel to pin it, and streaming remaps views all the time; after 16 refusals and no
+        // import, stop asking.
+        if (views.empty() && ++refused_in_a_row == 16) {
+            imports_refused = true;
+            LOG_WARNING(Render_Vulkan,
+                        "D1: the driver refuses to import guest memory ({}); draws read copies "
+                        "of it instead (as with SHADGT_DIRECT=0 for those buffers)",
+                        int(r));
+        }
         return fail("import refused");
     }
     VkExternalMemoryBufferCreateInfo external{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
diff --git a/src/video_core/buffer_cache/direct_memory.h b/src/video_core/buffer_cache/direct_memory.h
index 39694668..f20e1876 100644
--- a/src/video_core/buffer_cache/direct_memory.h
+++ b/src/video_core/buffer_cache/direct_memory.h
@@ -111,6 +111,8 @@ private:
     std::vector<u32> l2_index; // L1 entry -> L2 table + 1 (0: none)
     std::atomic<u64> imported_bytes{};
     std::atomic<u64> failed_count{};
+    u32 refused_in_a_row{}; // imports the driver refused before any view was imported
+    bool imports_refused{}; // the driver refuses every guest view: stop asking
     std::atomic<u64> volatile_pages{};
 };
 
-- 
